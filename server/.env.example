# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://codesync:codesync_dev@localhost:5432/codesync?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Bcrypt
BCRYPT_ROUNDS=12

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=codesync-storage
S3_REGION=us-east-1

# SonarQube
SONARQUBE_URL=http://localhost:9200
SONARQUBE_TOKEN=squ_dev_token

# ML Worker
ML_WORKER_URL=http://localhost:8000

# Email (Ethereal for development)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@codesync.dev

# Frontend URL (for verification links)
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000
